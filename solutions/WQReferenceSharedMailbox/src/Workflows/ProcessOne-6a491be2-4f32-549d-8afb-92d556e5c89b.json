                              },
                              "schema": {
                                "type": "object",
                                "required": [
                                  "validationPassed"
                                ],
                                "properties": {
                                  "validationPassed": {
                                    "type": "boolean"
                                  }
                                }
                              }
                            },
                            "runAfter": {},
                            "metadata": {
                              "qmcpErrorCode": "EXTRACTION_SENDER_MISMATCH"
                            }
                          }
                        }
                      },
                      "runAfter": {
                        "ValidateExtraction": [
                          "Succeeded"
                        ]
                      }
                    },
                    "BusinessDocument": {
                      "type": "Compose",
                      "inputs": {
                        "sourceKey": "@outputs('Acquired')?['SourceKey']",
                        "contentHash": "@outputs('Acquired')?['ContentHash']",
                        "testRun": "@outputs('Acquired')?['TestRun']",
                        "fields": "@body('ValidateExtraction')",
                        "promptVersion": "mail-extraction-v1.1",
                        "promptModelId": "@parameters('qmcp_PromptModelId')",
                        "modelVersion": "@coalesce(body('Prompt')?['responsev2']?['predictionOutput']?['modelName'],'unreported')",
                        "predictionId": "@body('Prompt')?['responsev2']?['predictionId']"
                      },
                      "runAfter": {
                        "ValidateSender": [
                          "Succeeded"
                        ]
                      }
                    },
                    "CreateRecord": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                          "connectionName": "qmcp_Dataverse",
                          "operationId": "CreateRecord"
                        },
                        "parameters": {
                          "entityName": "qmcp_emailrequests",
                          "item/qmcp_name": "@outputs('Acquired')?['BusinessKey']",
                          "item/qmcp_key": "@outputs('Acquired')?['BusinessKey']",
                          "item/qmcp_queuekey": "@parameters('qmcp_QueueKey')",
                          "item/qmcp_document": "@string(outputs('BusinessDocument'))"
                        },
                        "retryPolicy": {
                          "type": "none"
                        }
                      },
                      "runAfter": {
                        "BusinessDocument": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "FindExisting": [
                      "Succeeded"
                    ]
                  }
                },
                "FindResult": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "connectionName": "qmcp_Dataverse",
                      "operationId": "ListRecords"
                    },
                    "parameters": {
                      "entityName": "qmcp_emailrequests",
                      "$filter": "@concat('qmcp_key eq ''', outputs('Acquired')?['BusinessKey'], '''')",
                      "$top": 2
                    },
                    "retryPolicy": {
                      "type": "none"
                    }
                  },
                  "runAfter": {
                    "CreateIfAbsent": [
                      "Succeeded"
                    ]
                  }
                },
                "Reconciled": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@length(body('FindResult')?['value'])",
                          1
                        ]
                      },
                      {
                        "equals": [
                          "@json(first(body('FindResult')?['value'])?['qmcp_document'])?['contentHash']",
                          "@outputs('Acquired')?['ContentHash']"
                        ]
                      },
                      {
                        "equals": [
                          "@json(first(body('FindResult')?['value'])?['qmcp_document'])?['sourceKey']",
                          "@outputs('Acquired')?['SourceKey']"
                        ]
                      },
                      {
                        "equals": [
                          "@first(body('FindResult')?['value'])?['qmcp_queuekey']",
                          "@parameters('qmcp_QueueKey')"
                        ]
                      }
                    ]
                  },
                  "actions": {},
                  "else": {
                    "actions": {
                      "Conflict": {
                        "type": "ParseJson",
                        "inputs": {
                          "content": {
                            "code": "BUSINESS_CONTENT_CONFLICT"
                          },
                          "schema": {
                            "type": "object",
                            "required": [
                              "validationPassed"
                            ],
                            "properties": {
                              "validationPassed": {
                                "type": "boolean"
                              }
                            }
                          }
                        },
                        "runAfter": {},
                        "metadata": {
                          "qmcpErrorCode": "BUSINESS_CONTENT_CONFLICT"
                        }
                      }
                    }
                  },
                  "runAfter": {
                    "FindResult": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runAfter": {}
            },
            "OutputRecordId": {
              "type": "Compose",
              "inputs": "@first(body('FindResult')?['value'])?['qmcp_emailrequestid']",
              "runAfter": {
                "Business": [
                  "Succeeded"
                ]
              }
            },
            "Complete": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "qmcp_Dataverse",
                  "operationId": "PerformUnboundAction"
                },
                "parameters": {
                  "actionName": "qmcp_WQ_Complete",
                  "item/QueueKey": "@parameters('qmcp_QueueKey')",
                  "item/RequestId": "@outputs('RequestIds')?['Complete']",
                  "item/DataJson": "@string(setProperty(setProperty(json('{}'), 'table', 'qmcp_emailrequest'), 'recordId', outputs('OutputRecordId')))",
                  "item/ItemId": "@outputs('Acquired')?['ItemId']",
                  "item/AttemptId": "@outputs('Acquired')?['AttemptId']",
                  "item/Generation": "@outputs('Acquired')?['Generation']"
                },
                "retryPolicy": {
                  "type": "none"
                }
              },
              "runAfter": {
                "OutputRecordId": [
                  "Succeeded"
                ]
              }
            },
            "CompleteRetry": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "qmcp_Dataverse",
                  "operationId": "PerformUnboundAction"
                },
                "parameters": {
                  "actionName": "qmcp_WQ_Complete",
                  "item/QueueKey": "@parameters('qmcp_QueueKey')",
                  "item/RequestId": "@outputs('RequestIds')?['Complete']",
                  "item/DataJson": "@string(setProperty(setProperty(json('{}'), 'table', 'qmcp_emailrequest'), 'recordId', outputs('OutputRecordId')))",
                  "item/ItemId": "@outputs('Acquired')?['ItemId']",
                  "item/AttemptId": "@outputs('Acquired')?['AttemptId']",
                  "item/Generation": "@outputs('Acquired')?['Generation']"
                },
                "retryPolicy": {
                  "type": "none"
                }
              },
              "runAfter": {
                "Complete": [
                  "Failed",
                  "TimedOut"
                ]
              }
            },
            "CompletionUnknown": {
              "type": "Compose",
              "inputs": "Unknown",
              "runAfter": {
                "CompleteRetry": [
                  "Failed",
                  "TimedOut"
                ]
              }
            },
            "ReportFailure": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "qmcp_Dataverse",
                  "operationId": "PerformUnboundAction"
                },
                "parameters": {
                  "actionName": "qmcp_WQ_Fail",
                  "item/QueueKey": "@parameters('qmcp_QueueKey')",
                  "item/RequestId": "@outputs('RequestIds')?['Fail']",
                  "item/DataJson": "@string(setProperty(setProperty(setProperty(json('{}'),'category','Unknown'),'code',if(equals(actions('Prompt')?['status'],'TimedOut'),'PROMPT_TIMED_OUT',if(equals(actions('Prompt')?['status'],'Failed'),'PROMPT_FAILED',if(equals(actions('NormalizeExtraction')?['status'],'TimedOut'),'NORMALIZEEXTRACTION_TIMED_OUT',if(equals(actions('NormalizeExtraction')?['status'],'Failed'),'NORMALIZEEXTRACTION_FAILED',if(equals(actions('ValidateExtraction')?['status'],'TimedOut'),'VALIDATEEXTRACTION_TIMED_OUT',if(equals(actions('ValidateExtraction')?['status'],'Failed'),'VALIDATEEXTRACTION_FAILED',if(equals(actions('ValidateSender')?['status'],'TimedOut'),'VALIDATESENDER_TIMED_OUT',if(equals(actions('ValidateSender')?['status'],'Failed'),'VALIDATESENDER_FAILED',if(equals(actions('CreateRecord')?['status'],'TimedOut'),'CREATERECORD_TIMED_OUT',if(equals(actions('CreateRecord')?['status'],'Failed'),'CREATERECORD_FAILED',if(equals(actions('FindExisting')?['status'],'TimedOut'),'FINDEXISTING_TIMED_OUT',if(equals(actions('FindExisting')?['status'],'Failed'),'FINDEXISTING_FAILED',if(equals(actions('FindResult')?['status'],'TimedOut'),'FINDRESULT_TIMED_OUT',if(equals(actions('FindResult')?['status'],'Failed'),'FINDRESULT_FAILED',if(equals(actions('Reconciled')?['status'],'TimedOut'),'RECONCILED_TIMED_OUT',if(equals(actions('Reconciled')?['status'],'Failed'),'RECONCILED_FAILED','WORKER_SCOPE_FAILED'))))))))))))))))),'effect','Unknown'))",
                  "item/ItemId": "@outputs('Acquired')?['ItemId']",
                  "item/AttemptId": "@outputs('Acquired')?['AttemptId']",
                  "item/Generation": "@outputs('Acquired')?['Generation']"
                },
                "retryPolicy": {
                  "type": "none"
                }
              },
              "runAfter": {
                "Business": [
                  "Failed",
                  "TimedOut"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Acquired": [
              "Succeeded"
            ]
          }
        },
        "Respond": {
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "outcome": "@if(not(equals(coalesce(outputs('Acquired')?['Outcome'],'Unknown'),'Acquired')),coalesce(outputs('Acquired')?['Outcome'],'Unknown'),if(equals(actions('Complete')?['status'],'Succeeded'),coalesce(json(coalesce(body('Complete')?['ResultJson'],'{}'))?['Outcome'],'Unknown'),if(equals(actions('CompleteRetry')?['status'],'Succeeded'),coalesce(json(coalesce(body('CompleteRetry')?['ResultJson'],'{}'))?['Outcome'],'Unknown'),if(equals(actions('ReportFailure')?['status'],'Succeeded'),coalesce(json(coalesce(body('ReportFailure')?['ResultJson'],'{}'))?['Outcome'],'Unknown'),'Unknown'))))"
            }
          },
          "runAfter": {
            "HasWork": [
              "Succeeded",
              "Failed",
              "TimedOut",
              "Skipped"
            ]
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
