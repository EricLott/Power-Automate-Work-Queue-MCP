{
  "policy": {
    "NativeQueueId": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
    "Enabled": true,
    "MaxAttempts": 3,
    "LeaseSeconds": 120,
    "DeadlineSeconds": 1800,
    "RetryBaseSeconds": 30,
    "RetryMaxSeconds": 600,
    "SafeEffects": true,
    "Contracts": ["mail.v1"],
    "Grants": { "local-developer": ["producer", "worker", "reader", "tester", "coordinator", "watchdog", "sender", "retry"] },
    "Destinations": ["operations"],
    "NotificationRules": [
      { "Events": ["Processed", "RetryScheduled", "ReviewRequired", "IntakeFailure"], "Destination": "operations", "CooldownSeconds": 300, "Redaction": "Safe" }
    ],
    "Retention": { "PayloadDays": 30, "ReceiptDays": 30, "AttemptDays": 90, "EvidenceDays": 365, "ErrorDays": 90 }
  },
  "contract": {
    "Id": "mail.v1",
    "Dialect": "http://json-schema.org/draft-07/schema#",
    "Schema": {
      "type": "object",
      "required": ["subject", "senderAddress", "bodyText"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "maxLength": 1000 },
        "senderAddress": { "type": "string", "maxLength": 320 },
        "bodyText": { "type": "string", "maxLength": 50000 }
      }
    }
  }
}
